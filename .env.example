# Database
POSTGRES_USER=abusecve
POSTGRES_PASSWORD=abusecve_secret_change_me
POSTGRES_DB=abusecve
DATABASE_URL=postgresql+asyncpg://abusecve:abusecve_secret_change_me@postgres:5432/abusecve

# Redis
REDIS_URL=redis://redis:6379/0

# NVD API
NVD_API_KEY=your_nvd_api_key_here

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
