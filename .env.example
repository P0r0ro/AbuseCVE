# ============================================
# AbuseCVE Configuration
# ============================================

# Database
POSTGRES_USER=abusecve
POSTGRES_PASSWORD=abusecve_secret_change_me
POSTGRES_DB=abusecve
DATABASE_URL=postgresql+asyncpg://abusecve:abusecve_secret_change_me@postgres:5432/abusecve

# Redis
REDIS_URL=redis://redis:6379/0

# NVD API
NVD_API_KEY=your_nvd_api_key_here

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_TLS=true

# Email routing — per-type recipients
# ALERT_RECIPIENTS: CVE alert emails + scan summaries with >0 alerts (analysts)
ALERT_RECIPIENTS=analyst1@example.com,analyst2@example.com
# HEALTH_RECIPIENTS: daily health report emails (admin/ops). Falls back to ALERT_RECIPIENTS if empty.
HEALTH_RECIPIENTS=admin@example.com
# SCAN_RECIPIENTS: scan summary emails with 0 alerts (admin/debug). Falls back to ALERT_RECIPIENTS if empty.
SCAN_RECIPIENTS=admin@example.com
# WEBHOOK_EMAIL: contact email included in CRM/webhook payloads. Falls back to SMTP_FROM.
WEBHOOK_EMAIL=soc-alerts@example.com

# Scheduler
SCAN_INTERVAL_MINUTES=120
HEALTH_REPORT_HOUR=23
HEALTH_REPORT_MINUTE=59

# App
SECRET_KEY=change_me_to_a_random_string
APP_ENV=production
LOG_LEVEL=INFO
